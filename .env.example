# COPY this file to .env.local. Replace values marked [ADD ...].
# Safe to expose in browser only because product table has public-read RLS.
NEXT_PUBLIC_SUPABASE_URL=[ADD_SUPABASE_PROJECT_URL]
NEXT_PUBLIC_SUPABASE_ANON_KEY=[ADD_SUPABASE_PUBLISHABLE_OR_ANON_KEY]

# SERVER ONLY - never add NEXT_PUBLIC_ to secret values
SUPABASE_SERVICE_ROLE_KEY=[ADD_SUPABASE_SERVICE_ROLE_KEY]
STRIPE_SECRET_KEY=[ADD_STRIPE_SECRET_KEY]
STRIPE_WEBHOOK_SECRET=[ADD_STRIPE_WEBHOOK_SIGNING_SECRET]
NEXT_PUBLIC_SITE_URL=http://localhost:3000
